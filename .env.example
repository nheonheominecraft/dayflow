# Copy to .env (or export in your shell). Placeholders only. Never commit real values.
PORT=8787
DAYFLOW_DATA_DIR=./data
# 64 hex chars (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DAYFLOW_MASTER_KEY=replace-with-64-hex-characters
# Only set for local development / tests:
# DAYFLOW_ALLOW_HTTP=1
# DAYFLOW_ALLOW_PRIVATE=1
# DAYFLOW_DEV_RESET=1
# Set to 1 only behind a reverse proxy you control:
# DAYFLOW_TRUST_PROXY=1
# Comma-separated origins allowed to call the API from packaged apps:
# DAYFLOW_CORS_ORIGINS=http://localhost,capacitor://localhost
